# --- Database ---
# Any managed Postgres works: Neon (neon.tech), Supabase, Render Postgres, ElephantSQL...
# Free tiers exist on all of these — good enough to launch on.
DATABASE_URL=postgres://user:password@host:5432/kazi?sslmode=require

# --- Auth ---
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

# --- CORS ---
# The URL your frontend will be hosted at, e.g. https://kazi.co.ke
FRONTEND_URL=http://localhost:5500

# --- Safaricom Daraja (M-Pesa) ---
MPESA_ENV=sandbox                 # sandbox | production
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379             # 174379 = Daraja sandbox test Paybill
MPESA_PASSKEY=your_lipa_na_mpesa_online_passkey
MPESA_CALLBACK_URL=https://your-api-domain.example.com/api/payments/callback

# Fees, in whole Kenyan shillings (change any time without touching code)
FEE_POSTER_SUB=500
FEE_PRO_SUB=250
FEE_BID=50

PORT=4000
